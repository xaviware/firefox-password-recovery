*.vbw
*.scc
*.pdm
MSSCCPRJ.SCC
*.frx
*.vbp
*.tmp
*.temp
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.ncb
*.opt
*.plg
*.aps
*.clw
*.suo
*.user
*.userosscache
