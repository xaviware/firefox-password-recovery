# --- Archivos del Sistema Operativo ---
Thumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# --- Archivos Temporales y Backup ---
*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*~
*.~*

